    "check": "node tools/check.mjs",
    "test": "node --test tools/engine.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/instrument-serif": "0.4.1",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "gsap": "3.15.0"
  }
}
